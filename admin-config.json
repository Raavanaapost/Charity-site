{
  "backend": {
    "name": "github",
    "repo": "Raavanaapost/charity-site",
    "branch": "main",
    "commit_messages": {
      "update": "Update {{slug}} from admin"
    }
  },
  "media_folder": "/images/uploads",
  "public_folder": "/images/uploads",
  "editor": {
    "preview": false
  },
  "collections": [
    {
      "name": "projects",
      "label": "Projects",
      "icon": "volunteer_activism",
      "files": [
        {
          "name": "all-projects",
          "label": "All projects",
          "file": "projects.json",
          "format": "json",
          "fields": [
            {
              "name": "projects",
              "label": "Projects",
              "label_singular": "Project",
              "widget": "list",
              "collapsed": true,
              "summary": "{{fields.title}}",
              "add_to_top": true,
              "fields": [
                {
                  "name": "title",
                  "label": "Project title",
                  "widget": "string"
                },
                {
                  "name": "slug",
                  "label": "Link name",
                  "widget": "string",
                  "required": false,
                  "hint": "Short name used in the web address, e.g. clean-wells. Lowercase and dashes only. Leave empty to create it from the title. Changing it later breaks old links."
                },
                {
                  "name": "hidden",
                  "label": "Hide this project from the site",
                  "widget": "boolean",
                  "default": false,
                  "required": false
                },
                {
                  "name": "featured",
                  "label": "Feature this project on the home page",
                  "widget": "boolean",
                  "default": false,
                  "required": false,
                  "hint": "Turn this on for one project. If none is chosen, the first project is featured."
                },
                {
                  "name": "theme",
                  "label": "Category",
                  "widget": "select",
                  "options": [
                    "Trips & Events",
                    "Education"
                  ],
                  "required": false
                },
                {
                  "name": "status",
                  "label": "Status",
                  "widget": "select",
                  "options": [
                    "Planning",
                    "Active",
                    "Completed",
                    "Paused"
                  ],
                  "default": "Active",
                  "required": false
                },
                {
                  "name": "location",
                  "label": "Location",
                  "widget": "string",
                  "required": false,
                  "hint": "e.g. Kigoma, Tanzania"
                },
                {
                  "name": "organization",
                  "label": "Run by",
                  "widget": "string",
                  "required": false
                },
                {
                  "name": "started",
                  "label": "Started",
                  "widget": "string",
                  "required": false,
                  "hint": "e.g. March 2025"
                },
                {
                  "name": "reach",
                  "label": "Reach",
                  "widget": "string",
                  "required": false,
                  "hint": "Who benefits, e.g. 2,400 residents"
                },
                {
                  "name": "summary",
                  "label": "Short summary",
                  "widget": "text",
                  "hint": "One or two sentences shown on the project card and under the title."
                },
                {
                  "name": "cover",
                  "label": "Cover photo",
                  "widget": "image",
                  "required": false
                },
                {
                  "name": "quote",
                  "label": "Highlight quote",
                  "widget": "string",
                  "required": false,
                  "hint": "Optional quote from someone the project helps."
                },
                {
                  "name": "story",
                  "label": "Story",
                  "widget": "markdown",
                  "required": false,
                  "hint": "Use headings like 'The problem', 'What we're doing', 'Long-term impact'."
                },
                {
                  "name": "impact",
                  "label": "Impact numbers",
                  "label_singular": "Impact number",
                  "widget": "list",
                  "required": false,
                  "summary": "{{fields.value}} {{fields.label}}",
                  "fields": [
                    {
                      "name": "value",
                      "label": "Number",
                      "widget": "string",
                      "hint": "e.g. 2,400 or 71%"
                    },
                    {
                      "name": "label",
                      "label": "What it counts",
                      "widget": "string",
                      "hint": "e.g. people with clean water"
                    }
                  ]
                },
                {
                  "name": "updates",
                  "label": "Impact updates",
                  "label_singular": "Impact update",
                  "widget": "list",
                  "required": false,
                  "add_to_top": true,
                  "summary": "{{fields.date}} \u00b7 {{fields.title}}",
                  "fields": [
                    {
                      "name": "date",
                      "label": "Date",
                      "widget": "datetime",
                      "time_format": false,
                      "format": "YYYY-MM-DD"
                    },
                    {
                      "name": "title",
                      "label": "Headline",
                      "widget": "string"
                    },
                    {
                      "name": "body",
                      "label": "Update",
                      "widget": "markdown"
                    }
                  ]
                },
                {
                  "name": "photos",
                  "label": "Pictures",
                  "label_singular": "Picture",
                  "widget": "list",
                  "required": false,
                  "summary": "{{fields.caption}}",
                  "fields": [
                    {
                      "name": "image",
                      "label": "Photo",
                      "widget": "image"
                    },
                    {
                      "name": "caption",
                      "label": "Caption",
                      "widget": "string",
                      "required": false
                    }
                  ],
                  "hint": "Only post pictures of people who agreed to be shown. For children, get a parent's permission."
                },
                {
                  "name": "media",
                  "label": "Videos",
                  "label_singular": "Video",
                  "widget": "list",
                  "required": false,
                  "summary": "{{fields.title}}",
                  "fields": [
                    {
                      "name": "title",
                      "label": "Title",
                      "widget": "string",
                      "required": false
                    },
                    {
                      "name": "url",
                      "label": "Link",
                      "widget": "string",
                      "hint": "Paste a YouTube or Vimeo link (SoundCloud audio links also work)."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "comments",
      "label": "Comments",
      "icon": "forum",
      "files": [
        {
          "name": "all-comments",
          "label": "Visitor comments",
          "file": "comments.json",
          "format": "json",
          "fields": [
            {
              "name": "comments",
              "label": "Comments",
              "label_singular": "Comment",
              "widget": "list",
              "collapsed": true,
              "summary": "{{fields.name}} on {{fields.project}} \u00b7 shown: {{fields.approved}}",
              "hint": "New comments appear here and on the site automatically. To hide one, switch off \"Show on the site\" and save, or delete it.",
              "fields": [
                {
                  "name": "approved",
                  "label": "Show on the site",
                  "widget": "boolean",
                  "default": true
                },
                {
                  "name": "name",
                  "label": "Name",
                  "widget": "string"
                },
                {
                  "name": "project",
                  "label": "Project link name",
                  "widget": "string",
                  "hint": "Which project this comment belongs to."
                },
                {
                  "name": "comment",
                  "label": "Comment",
                  "widget": "text"
                },
                {
                  "name": "date",
                  "label": "Date",
                  "widget": "string",
                  "required": false
                },
                {
                  "name": "id",
                  "label": "Reference",
                  "widget": "hidden",
                  "required": false
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "settings",
      "label": "Site settings",
      "icon": "settings",
      "files": [
        {
          "name": "site",
          "label": "Name and About page",
          "file": "site.json",
          "format": "json",
          "fields": [
            {
              "name": "name",
              "label": "Site name",
              "widget": "string"
            },
            {
              "name": "tagline",
              "label": "Home page headline",
              "widget": "string",
              "hint": "Used when a slide has no headline of its own. The first letter is shown large."
            },
            {
              "name": "intro",
              "label": "Home page intro",
              "widget": "text"
            },
            {
              "name": "sayings",
              "label": "Home page slideshow",
              "label_singular": "Slide",
              "widget": "list",
              "required": false,
              "hint": "Each slide has a headline, a picture and a message. Slides change every few seconds and a different one comes first on each visit.",
              "summary": "{{fields.title}}",
              "fields": [
                {
                  "name": "title",
                  "label": "Headline",
                  "widget": "string",
                  "required": false,
                  "hint": "Keep it short so it fits on one line, e.g. Together \u2013 Real Change. If empty, the Home page headline is used."
                },
                {
                  "name": "text",
                  "label": "Message",
                  "widget": "text",
                  "hint": "About two sentences."
                },
                {
                  "name": "image",
                  "label": "Picture",
                  "widget": "image",
                  "required": false,
                  "hint": "Wide pictures work best (twice as wide as tall)."
                }
              ]
            },
            {
              "name": "follow",
              "label": "Sign-up box slides",
              "label_singular": "Slide",
              "widget": "list",
              "required": false,
              "summary": "{{fields.title}}",
              "hint": "The box where visitors leave their email. Each slide has a title and a short message shown on top of a small picture. A different one comes first on each visit.",
              "fields": [
                {
                  "name": "title",
                  "label": "Title",
                  "widget": "string"
                },
                {
                  "name": "text",
                  "label": "Message",
                  "widget": "text",
                  "hint": "One or two short sentences."
                },
                {
                  "name": "image",
                  "label": "Picture",
                  "widget": "image",
                  "required": false,
                  "hint": "Wide and not too busy, so the message stays readable on top."
                }
              ]
            },
            {
              "name": "volunteer",
              "label": "Volunteer page slides",
              "label_singular": "Slide",
              "widget": "list",
              "required": false,
              "summary": "{{fields.title}}",
              "hint": "Shown at the top of the Volunteer page. Each slide has a title and a short message on top of a small picture. A different one comes first on each visit.",
              "fields": [
                {
                  "name": "title",
                  "label": "Title",
                  "widget": "string"
                },
                {
                  "name": "text",
                  "label": "Message",
                  "widget": "text",
                  "hint": "One or two short sentences."
                },
                {
                  "name": "image",
                  "label": "Picture",
                  "widget": "image",
                  "required": false,
                  "hint": "Wide and not too busy, so the message stays readable on top."
                }
              ]
            },
            {
              "name": "contact",
              "label": "Contact page slides",
              "label_singular": "Slide",
              "widget": "list",
              "required": false,
              "summary": "{{fields.title}}",
              "hint": "Shown at the top of the Contact page. Each slide has a title and a short message on top of a small picture. A different one comes first on each visit.",
              "fields": [
                {
                  "name": "title",
                  "label": "Title",
                  "widget": "string"
                },
                {
                  "name": "text",
                  "label": "Message",
                  "widget": "text",
                  "hint": "One or two short sentences."
                },
                {
                  "name": "image",
                  "label": "Picture",
                  "widget": "image",
                  "required": false,
                  "hint": "Wide and not too busy, so the message stays readable on top."
                }
              ]
            },
            {
              "name": "impact",
              "label": "Impact in numbers",
              "label_singular": "Number",
              "widget": "list",
              "required": false,
              "summary": "{{fields.label}}",
              "hint": "The number tiles at the top of the Impact page. Type a number yourself, or let the site count it for you.",
              "fields": [
                {
                  "name": "label",
                  "label": "What it counts",
                  "widget": "string",
                  "hint": "For example: Volunteers"
                },
                {
                  "name": "count",
                  "label": "Where the number comes from",
                  "widget": "select",
                  "default": "manual",
                  "options": [
                    {
                      "label": "I type the number below",
                      "value": "manual"
                    },
                    {
                      "label": "Count the Trips & Events projects",
                      "value": "trips"
                    },
                    {
                      "label": "Count the stories posted",
                      "value": "stories"
                    },
                    {
                      "label": "Count all projects",
                      "value": "projects"
                    }
                  ]
                },
                {
                  "name": "value",
                  "label": "Number",
                  "widget": "string",
                  "required": false,
                  "hint": "Only needed when you type the number yourself, e.g. 25"
                }
              ]
            },
            {
              "name": "highlights",
              "label": "Extra home page numbers",
              "label_singular": "Number",
              "widget": "list",
              "required": false,
              "hint": "Project, active and update counts are added automatically. Add your own here, e.g. 12,000 / people reached.",
              "summary": "{{fields.value}} {{fields.label}}",
              "fields": [
                {
                  "name": "value",
                  "label": "Number",
                  "widget": "string"
                },
                {
                  "name": "label",
                  "label": "What it counts",
                  "widget": "string"
                }
              ]
            },
            {
              "name": "about",
              "label": "About page",
              "widget": "markdown"
            },
            {
              "name": "facebook",
              "label": "Facebook page link",
              "widget": "string",
              "required": false,
              "hint": "Paste the full link. Leave empty to hide it."
            },
            {
              "name": "instagram",
              "label": "Instagram link",
              "widget": "string",
              "required": false,
              "hint": "Leave empty to hide it."
            },
            {
              "name": "email",
              "label": "Contact email",
              "widget": "string",
              "required": false,
              "hint": "Shown in the footer. Leave empty to hide it."
            },
            {
              "name": "footer",
              "label": "Footer note",
              "widget": "string",
              "required": false,
              "hint": "Optional small note at the very bottom, e.g. a registration number."
            }
          ]
        }
      ]
    }
  ]
}